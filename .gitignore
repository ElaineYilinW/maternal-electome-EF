# Data — keep on RDSS, never commit
*.pkl
*.pt
*.mat

# Exception: the 6 paper-active EF models in models/ ARE committed
# (small, ~3 MB total, needed for the examples/vignette.ipynb walkthrough)
!models/*.pt

# (the example recordings in examples/demo_data/{lfps,chans,behavior}/ are un-ignored at the
#  bottom of this file — the exception has to come after the *.xlsx rule)

# Backup / dirty notebooks
*_BACKUP.ipynb
*_dirty*.ipynb
.ipynb_checkpoints/

# Executed copies of the tutorial (CI smoke test, README option B) and
# everything the tutorial writes when it runs. The committed tutorial.ipynb
# is the real one; results/ is regenerated by whoever runs it.
examples/tutorial_ci.ipynb
examples/tutorial_run.ipynb
examples/results/

# Paper / manuscript drafts kept inside the repo working directory
# (they live alongside the code for convenience but should not be committed)
*.docx
*.pptx
~$*.docx
~$*.pptx

# Generated figures and result dirs
*.png
*.pdf
results_*/
model_checkpoints*/
temp_best_model.pt

# Generated table artifacts (xlsx from create_four_visualizations_with_tables
# and the Sara request wrappers; CSV companions from run_stage_backproject and
# run_circos_prep)
*.xlsx
*_circos_input.csv
individual_scores_by_stage.csv
individual_percentage_changes.csv
group_scores_by_stage.csv
group_percentage_changes.csv
statistical_tests_c_vs_e.csv
fisher_combined_pvalues.csv
p4_filtering_summary.csv

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
env/
.python-version
*.egg-info/

# OS / editors
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
DEV_LOG.md

# Paper-era reference numbers extracted from BACKUP notebook outputs
# (local-only working scratch for Plan A bit-exact reproduce comparison)
PAPER_NUMBERS.md
REFERENCE_NUMBERS.md

# nbconvert stdout/stderr logs (local-only)
run_logs/

# Local-only files (visible on dev machine, not on GitHub)
notebooks/00_data_preprocessing.ipynb
CLEANUP_LOG.md
README.local.md
models/README.local.md

# Exception (must come last — later rules win): the example recording shipped
# with examples/tutorial.ipynb: two real P8 recordings (one control dam, one
# ELS dam) trimmed to ~7 min excerpts, ~21 MB each -- sorted by file type into
# lfps/, chans/ and behavior/, the layout the tutorial documents.
!examples/demo_data/lfps/*.mat
!examples/demo_data/chans/*.mat
!examples/demo_data/behavior/*.xlsx
